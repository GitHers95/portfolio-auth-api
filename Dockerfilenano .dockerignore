# 1. Image de base : Python 3.13 (légère)
FROM python:3.13-slim

# 2. Définir le répertoire de travail à l'intérieur du conteneur
WORKDIR /app

# 3. Copier d'abord le fichier des dépendances (pour optimiser le cache)
COPY requirements.txt .

# 4. Installer les dépendances
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copier tout le reste du code source (app/, .env, etc.)
COPY . .

# 6. Exposer le port 8000 (celui utilisé par FastAPI)
EXPOSE 8000

# 7. Commande de lancement de l'API

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
